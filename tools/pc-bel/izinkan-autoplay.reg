Windows Registry Editor Version 5.00

; Izinkan suara otomatis (autoplay) untuk halaman bel di Chrome & Edge,
; dan jangan bekukan/buang tab bel saat PC lama tidak disentuh.
; Jalankan dengan klik kanan -> Merge (perlu hak Administrator), lalu restart browser.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"AutoplayAllowed"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\AutoplayAllowlist]
"1"="https://bell.mtsn2kotamalang.sch.id"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\TabDiscardingExceptions]
"1"="https://bell.mtsn2kotamalang.sch.id"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"AutoplayAllowed"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\AutoplayAllowlist]
"1"="https://bell.mtsn2kotamalang.sch.id"
